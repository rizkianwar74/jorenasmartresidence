# Template konfigurasi Midtrans.
# Copy file ini jadi .env, lalu isi key asli dari dashboard Midtrans.
#   cp .env.example .env
#
# .env di-gitignore (tidak ikut commit). .env.example boleh di-commit.

MIDTRANS_SERVER_KEY=Mid-server-GANTI_DENGAN_SERVER_KEY_KAMU
MIDTRANS_CLIENT_KEY=Mid-client-GANTI_DENGAN_CLIENT_KEY_KAMU
MIDTRANS_IS_PRODUCTION=false
