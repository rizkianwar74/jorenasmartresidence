# Template konfigurasi API keys.
# Copy file ini jadi .env, lalu isi key asli dari masing-masing dashboard.
#   cp .env.example .env
#
# .env di-gitignore (tidak ikut commit). .env.example boleh di-commit.

# ── Pakasir (payment gateway) ─────────────────────────────────────────────────
# Slug: nama proyek di dashboard Pakasir (mis. "smart-residence")
# Catatan: PAKASIR_API_KEY SENGAJA tidak ada di sini — api_key tidak boleh
# ada di client (app Flutter). Verifikasi pembayaran dilakukan oleh server
# webhook terpisah (server/pakasir-webhook/.env.example). Lihat
# docs/payment_webhook_fix_prompt.md untuk detail.
PAKASIR_SLUG=GANTI_DENGAN_SLUG_PROYEK_KAMU

# ── OneSignal (push notification) ────────────────────────────────────────────
# REST API Key dari dashboard OneSignal → Settings → Keys & IDs
ONESIGNAL_REST_API_KEY=GANTI_DENGAN_ONESIGNAL_REST_API_KEY_KAMU
