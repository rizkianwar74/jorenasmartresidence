@startuml
title Activity Diagram Panggil Satpam (SOS / Bantuan)

skinparam shadowing false
skinparam defaultFontName Serif
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ArrowColor #333333
skinparam swimlaneBorderColor #999999

|Penghuni|
start
if (Jenis permintaan?) then (SOS)
  :Tekan tombol SOS;
else (Bantuan)
  :Isi form bantuan;
endif

|Aplikasi Mobile|
:Validasi data permintaan;

|Firebase Firestore|
if (Jenis = SOS?) then (ya)
  :Simpan dokumen ke koleksi sosalert;
else (tidak)
  :Simpan dokumen ke koleksi bantuanrequest;
endif

|Aplikasi Mobile|
:Kirim permintaan notifikasi ke server\n(jenis + docId + Firebase ID Token);

|Server Tepercaya (Vercel)|
:Verifikasi Firebase ID Token & peran;
:Baca dokumen dari Firestore & susun pesan;

|OneSignal|
:Kirim push ke satpam bertugas\n(tag role=satpam, onDuty=true);

|Satpam|
:Menerima notifikasi & alarm;
:Membuka detail permintaan;
:Tekan tombol "On My Way";

|Aplikasi Mobile|
:Perbarui status = ON_MY_WAY;

|Server Tepercaya (Vercel)|
:Verifikasi & teruskan notifikasi "menuju lokasi";

|OneSignal|
:Kirim push ke penghuni;

|Penghuni|
:Menerima notifikasi "Satpam menuju lokasi";

|Satpam|
:Menuju lokasi & menangani permintaan;
:Tekan tombol "Selesai";

|Aplikasi Mobile|
:Perbarui status = RESOLVED;

|Server Tepercaya (Vercel)|
:Verifikasi & teruskan notifikasi penyelesaian;

|OneSignal|
:Kirim push ke penghuni;

|Penghuni|
:Menerima notifikasi "Permintaan selesai";
stop

legend right
  Seluruh push notification melewati Server Tepercaya.
  REST API Key OneSignal hanya tersimpan di server,
  tidak di aplikasi. Server memverifikasi Firebase ID
  Token dan peran pemohon sebelum memanggil OneSignal.
endlegend

@enduml
