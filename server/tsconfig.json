{
  // moduleResolution "node" / "node10" sudah deprecated dan akan berhenti
  // berfungsi di TypeScript 7.0. Dipakai "node16" — bukan disenyapkan lewat
  // ignoreDeprecations — supaya konfigurasi ini tetap sah baik pada TypeScript
  // 5.x milik proyek maupun pada versi 6.x yang dipakai editor.
  //
  // package.json tidak memuat "type": "module", sehingga "module": "node16"
  // tetap menghasilkan CommonJS, sesuai yang diharapkan runtime Vercel.
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "lib/**/*.ts"]
}
