# Salin file ini jadi .env untuk development lokal (vercel dev).
# Untuk production, isi nilai yang sama di Vercel Dashboard →
# Project Settings → Environment Variables (JANGAN commit .env asli ke git).
#
# Seluruh kredensial rahasia sistem Smart Residence hanya hidup di sini.
# Tidak satu pun boleh ikut ke app Flutter.

# ── Pakasir (payment gateway) ────────────────────────────────────────────────
# Slug project Pakasir (dari dashboard Pakasir → Settings)
PAKASIR_SLUG=

# API Key Pakasir (dari dashboard Pakasir → Settings → API Key)
PAKASIR_API_KEY=

# ── Firebase Admin SDK ───────────────────────────────────────────────────────
# Isi seluruh isi file JSON service account Firebase (Project Settings →
# Service Accounts → Generate new private key) sebagai satu string di sini.
# Boleh multi-baris persis seperti file aslinya — Vercel mendukung env var
# multi-baris.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── OneSignal (push notification) ────────────────────────────────────────────
# App ID: dashboard OneSignal → Settings → Keys & IDs.
# App ID bersifat PUBLIK dan memang juga disematkan di app Flutter — nilainya
# tidak bisa dipakai untuk mengirim notifikasi.
ONESIGNAL_APP_ID=

# REST API Key: dashboard OneSignal → Settings → Keys & IDs.
#
# PENTING: key yang selama ini dipakai app Flutter sudah harus dianggap BOCOR,
# karena ikut terkemas ke dalam setiap APK yang pernah dibuat. Lakukan
# "Regenerate" di dashboard OneSignal lebih dahulu, lalu isi key BARU di sini.
# Key lama otomatis tidak berlaku begitu di-regenerate.
ONESIGNAL_REST_API_KEY=
